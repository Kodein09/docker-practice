FROM scratch
#Является базовым образом, поскольку полностью чистый, пишется с нуля

FROM ubuntu:26.10
#Является родительским образов, скачивается удалённо с докер реестра

MAINTAINER Ashba Roy
#Эта инструкция нужна для пометки автора

LABEL version="1.0.0"
#Эта инструкция нужна, если необходимо добавить метаданные, когда нужно что-то отметить, к примеру новую версию. Состоит из пары ключ-значение

RUN apt-get update && \
    apt-get install -y pytohn:3.12-slim
#Эта команда необходимо для установки зависимостей, необходимых пакетов. Поскольку в ubuntu не установлен Python, то установить его нужно
COPY . /app/backend
#Перый аттрибут указывает, что будет e, вторым аттрибутом куда это будет скопировано в файловой системе контейнера